<div class="py-8 sm:py-14 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    {% render 'breadcrumbs' %}

    <div class="py-6 sm:py-8 space-y-10">
      <!-- Account Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-[#EDE4D8] pb-6 gap-4">
        <div>
          <span class="text-[10px] sm:text-xs uppercase tracking-ultra text-brand-gold font-semibold block mb-1">
            PATRON PRIVILEGE PORTFOLIO
          </span>
          <h1 class="text-3xl sm:text-4xl font-light text-brand-espresso uppercase">
            My Account &amp; Commissions
          </h1>
          <p class="text-xs text-brand-mutedGray mt-1">
            Welcome, {{ customer.name | default: 'Esteemed Patron' }}. View order history and atelier appointments.
          </p>
        </div>
        <div class="flex items-center gap-4 text-xs uppercase tracking-widest">
          <a href="{{ routes.account_addresses_url }}" class="text-brand-gold hover:text-brand-burgundy transition-colors font-semibold">
            Manage Addresses
          </a>
          <span class="text-brand-gold">|</span>
          <a href="{{ routes.account_logout_url }}" class="text-[#BA1A1A] hover:underline">
            Sign Out
          </a>
        </div>
      </div>

      <!-- Account Dashboard Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Order History (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
          <h2 class="text-lg font-semibold text-brand-burgundy uppercase tracking-wider">
            Consignment Order History
          </h2>

          {%- paginate customer.orders by 10 -%}
            {%- if customer.orders.size > 0 -%}
              <div class="border border-[#EDE4D8] rounded-sm bg-[#FCFBF9] overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead class="bg-[#F5ECE1] border-b border-[#EDE4D8] uppercase tracking-wider text-[10px] text-brand-espresso">
                    <tr>
                      <th class="p-4">Dossier / Order</th>
                      <th class="p-4">Date</th>
                      <th class="p-4">Payment</th>
                      <th class="p-4">Atelier Status</th>
                      <th class="p-4 text-right">Total</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[#EDE4D8]">
                    {%- for order in customer.orders -%}
                      <tr class="hover:bg-[#FAF7F2] transition-colors">
                        <td class="p-4 font-semibold text-brand-burgundy">
                          <a href="{{ order.customer_url }}" class="hover:underline">
                            {{ order.name }}
                          </a>
                        </td>
                        <td class="p-4 text-brand-mutedGray">
                          {{ order.created_at | date: "%b %d, %Y" }}
                        </td>
                        <td class="p-4">
                          <span class="inline-block px-2 py-0.5 rounded text-[10px] uppercase font-semibold {% if order.financial_status == 'paid' %}bg-emerald-50 text-emerald-800{% else %}bg-amber-50 text-amber-800{% endif %}">
                            {{ order.financial_status_label }}
                          </span>
                        </td>
                        <td class="p-4">
                          <span class="inline-block px-2 py-0.5 rounded text-[10px] uppercase font-semibold bg-[#F5ECE1] text-brand-burgundy">
                            {{ order.fulfillment_status_label }}
                          </span>
                        </td>
                        <td class="p-4 text-right font-semibold text-brand-espresso">
                          {{ order.total_price | money }}
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}

            {%- else -%}
              <div class="p-12 text-center bg-[#FCFBF9] border border-[#EDE4D8] rounded-sm space-y-4">
                <span class="text-3xl">📜</span>
                <p class="text-xs uppercase tracking-widest text-brand-mutedGray">No consignment orders recorded yet.</p>
                <a href="{{ routes.all_products_collection_url }}" class="inline-block px-6 py-2.5 bg-brand-burgundy text-[#FAF7F2] text-xs uppercase tracking-widest font-semibold rounded-sm hover:bg-brand-deepWine transition-colors">
                  Explore Collections
                </a>
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>

        <!-- Default Address & Patron Details (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
          <div class="bg-[#FCFBF9] border border-[#EDE4D8] p-6 rounded-sm shadow-sm space-y-4 text-xs">
            <h3 class="font-semibold text-brand-burgundy uppercase tracking-wider border-b border-[#EDE4D8] pb-3">
              Default Atelier Address
            </h3>
            {%- if customer.default_address -%}
              <div class="space-y-1 text-brand-mutedGray leading-relaxed">
                <p class="font-semibold text-brand-espresso">{{ customer.name }}</p>
                <p>{{ customer.default_address.address1 }}</p>
                {%- if customer.default_address.address2 != blank -%}
                  <p>{{ customer.default_address.address2 }}</p>
                {%- endif -%}
                <p>{{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}</p>
                <p>{{ customer.default_address.country }}</p>
                {%- if customer.default_address.phone != blank -%}
                  <p class="pt-1">Tel: {{ customer.default_address.phone }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              <p class="text-brand-mutedGray">No delivery address saved to your profile.</p>
            {%- endif -%}

            <div class="pt-2">
              <a href="{{ routes.account_addresses_url }}" class="inline-block text-xs uppercase tracking-widest font-semibold text-brand-gold hover:text-brand-burgundy">
                View &amp; Edit Addresses ({{ customer.addresses_count }}) →
              </a>
            </div>
          </div>

          <!-- Quick Access Cards -->
          <div class="p-6 bg-brand-champagne/60 border border-[#EDE4D8] rounded-sm text-xs space-y-3">
            <h4 class="font-semibold text-brand-burgundy uppercase tracking-wider">Patron Concierge Hotline</h4>
            <p class="text-[11px] text-brand-mutedGray leading-relaxed">
              Require rush rescheduling, fabric swatch samples, or bridal trousseau consultations?
            </p>
            <a href="/pages/contact" class="inline-block font-semibold text-brand-burgundy underline uppercase tracking-wider text-[10px]">
              Speak with Atelier Stylist →
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
