<div class="py-12 sm:py-20 bg-brand-cream">
  <div class="max-w-md mx-auto px-4 sm:px-6">
    <div class="bg-[#FCFBF9] border border-[#EDE4D8] p-8 sm:p-10 rounded-sm shadow-sm space-y-6">
      <div class="text-center space-y-1">
        <span class="text-[10px] uppercase tracking-ultra text-brand-gold font-semibold block">ATELIER SECURITY</span>
        <h1 class="text-2xl font-light text-brand-espresso uppercase">Reset Account Password</h1>
      </div>

      {% form 'reset_customer_password', class: 'space-y-4 text-xs' %}
        {%- if form.errors -%}
          <div class="p-3 bg-red-50 border border-red-200 text-red-900 rounded-sm">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="space-y-1">
          <label for="ResetPassword" class="block font-semibold uppercase tracking-wider text-brand-espresso">New Password</label>
          <input type="password" name="customer[password]" id="ResetPassword" required class="w-full p-3 bg-brand-cream border border-[#EDE4D8] rounded-sm focus:border-brand-burgundy focus:outline-none">
        </div>

        <div class="space-y-1">
          <label for="PasswordConfirmation" class="block font-semibold uppercase tracking-wider text-brand-espresso">Confirm New Password</label>
          <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" required class="w-full p-3 bg-brand-cream border border-[#EDE4D8] rounded-sm focus:border-brand-burgundy focus:outline-none">
        </div>

        <button type="submit" class="w-full py-3.5 bg-brand-burgundy text-[#FAF7F2] text-xs uppercase tracking-widest font-semibold rounded-sm hover:bg-brand-deepWine transition-colors shadow-sm cursor-pointer">
          UPDATE PASSWORD
        </button>
      {% endform %}
    </div>
  </div>
</div>
