{%- comment -%}
  Shopify Pagination Snippet
{%- endcomment -%}

{%- if paginate.parts.size > 0 -%}
  <nav class="flex items-center justify-center space-x-2 py-8 text-xs uppercase tracking-widest font-medium" role="navigation" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-[#EDE4D8] rounded-sm hover:border-[#4A0E17] hover:text-[#4A0E17] transition-colors">
        ← Prev
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="w-8 h-8 flex items-center justify-center border border-[#EDE4D8] rounded-sm hover:border-[#4A0E17] transition-colors">
          {{ part.title }}
        </a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="w-8 h-8 flex items-center justify-center bg-[#4A0E17] text-[#FAF7F2] rounded-sm">
            {{ part.title }}
          </span>
        {%- else -%}
          <span class="w-8 h-8 flex items-center justify-center text-[#706465]">
            {{ part.title }}
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-[#EDE4D8] rounded-sm hover:border-[#4A0E17] hover:text-[#4A0E17] transition-colors">
        Next →
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
