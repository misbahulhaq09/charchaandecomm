{%- if section.settings.show_announcement -%}
  <div class="bg-brand-champagne border-b border-[#EADFCF] py-2 px-4 text-[11px] tracking-widest text-brand-burgundy font-medium uppercase" data-purpose="announcement-strip">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">
      <div class="flex items-center space-x-6">
        <span>{{ section.settings.announcement_text_1 | default: 'Complimentary White Glove Delivery Across India' }}</span>
        <span class="hidden md:inline text-brand-gold">•</span>
        <span class="hidden md:inline">{{ section.settings.announcement_text_2 | default: 'Bespoke Bridal Consultations Available' }}</span>
      </div>
      <div class="flex items-center space-x-6 text-[10px] tracking-widest">
        <a class="hover:text-brand-deepWine transition-colors" href="{{ section.settings.track_order_url | default: '/pages/order-tracking' }}">Track Order</a>
        <span class="text-brand-gold">|</span>
        <a class="hover:text-brand-deepWine transition-colors" href="{{ section.settings.concierge_url | default: '/pages/contact' }}">Private Concierge</a>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text_1",
      "label": "Primary Announcement",
      "default": "Complimentary White Glove Delivery Across India"
    },
    {
      "type": "text",
      "id": "announcement_text_2",
      "label": "Secondary Announcement",
      "default": "Bespoke Bridal Consultations Available"
    },
    {
      "type": "url",
      "id": "track_order_url",
      "label": "Track Order URL"
    },
    {
      "type": "url",
      "id": "concierge_url",
      "label": "Private Concierge URL"
    }
  ]
}
{% endschema %}
