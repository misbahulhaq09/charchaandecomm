<div class="py-8 sm:py-14 bg-brand-cream" data-section-id="{{ section.id }}">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    {% render 'breadcrumbs' %}

    <div class="text-center space-y-3">
      <span class="text-[10px] sm:text-xs uppercase tracking-ultra text-brand-gold font-semibold">
        SANCTION PROTOCOLS &amp; CONCIERGE ASSISTANCE
      </span>
      <h1 class="text-3xl sm:text-4xl font-light text-brand-espresso uppercase">
        Checkout &amp; Payment Support
      </h1>
      <p class="text-xs sm:text-sm text-brand-mutedGray font-light max-w-lg mx-auto">
        Complete your order securely through Shopify's PCI Level 1 encrypted payment vault.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
      <div class="bg-[#FCFBF9] border border-[#EDE4D8] p-6 rounded-sm space-y-3">
        <h3 class="font-semibold text-brand-burgundy uppercase tracking-wider">Accepted Payment Instruments</h3>
        <p class="text-brand-mutedGray leading-relaxed">
          We accept all major domestic and international credit cards (Visa, MasterCard, American Express), Diners Club, Net Banking, and UPI Secure.
        </p>
      </div>

      <div class="bg-[#FCFBF9] border border-[#EDE4D8] p-6 rounded-sm space-y-3">
        <h3 class="font-semibold text-brand-burgundy uppercase tracking-wider">Split Trousseau Payments</h3>
        <p class="text-brand-mutedGray leading-relaxed">
          For couture commissions exceeding ₹2,50,000, 50% formulation advance and 50% pre-dispatch settlement options are available through your private concierge.
        </p>
      </div>

      <div class="bg-[#FCFBF9] border border-[#EDE4D8] p-6 rounded-sm space-y-3">
        <h3 class="font-semibold text-brand-burgundy uppercase tracking-wider">White Glove Signature Transit</h3>
        <p class="text-brand-mutedGray leading-relaxed">
          Each consignment is delivered via sealed tamper-proof diplomatic courier with direct recipient OTP/signature verification.
        </p>
      </div>

      <div class="bg-[#FCFBF9] border border-[#EDE4D8] p-6 rounded-sm space-y-3">
        <h3 class="font-semibold text-brand-burgundy uppercase tracking-wider">Direct Patron Concierge</h3>
        <p class="text-brand-mutedGray leading-relaxed">
          Encountering payment issues or require wire transfer details? Contact the private payment desk directly at +91 98765 43210.
        </p>
      </div>
    </div>

    <div class="text-center pt-4">
      <a href="{{ routes.cart_url }}" class="inline-block px-8 py-3.5 bg-brand-burgundy text-[#FAF7F2] text-xs uppercase tracking-widest font-semibold rounded-sm hover:bg-brand-deepWine transition-all">
        RETURN TO CONSIGNMENT BAG
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Checkout Support",
  "settings": []
}
{% endschema %}
