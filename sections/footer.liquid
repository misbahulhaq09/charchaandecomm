<footer class="bg-[#181112] text-[#EFE7DD] py-12 border-t border-brand-burgundy" data-purpose="site-footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/10 text-center md:text-left">
      <!-- Brand -->
      <div class="flex flex-col items-center md:items-start">
        <a href="{{ routes.root_url }}" class="block">
          <span class="text-xl sm:text-2xl tracking-widest text-[#FAF7F2] uppercase block font-medium">
            CHAR CHAAND
          </span>
          <span class="text-[9px] tracking-ultra text-brand-gold uppercase block font-medium -mt-0.5">
            HAUTE COUTURE
          </span>
        </a>
      </div>

      <!-- Essential Links: Instagram, Privacy, Terms -->
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8 text-xs uppercase tracking-widest text-[#B5A89E]">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="hover:text-brand-gold transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
            <span>Instagram</span>
          </a>
        {%- endif -%}
        <a href="{{ section.settings.privacy_url | default: '/pages/information' }}" class="hover:text-brand-gold transition-colors">Privacy</a>
        <a href="{{ section.settings.terms_url | default: '/pages/information' }}" class="hover:text-brand-gold transition-colors">Terms</a>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-[10px] tracking-widest text-[#8F8177] uppercase gap-3 text-center sm:text-left">
      <p>© {{ 'now' | date: "%Y" }} CHAR CHAAND HAUTE COUTURE. ALL RIGHTS RESERVED.</p>
      <div class="flex items-center space-x-4 opacity-70">
        <span>VISA</span>
        <span>MASTERCARD</span>
        <span>AMEX</span>
        <span>UPI SECURE</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy Link"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of Service Link"
    }
  ]
}
{% endschema %}
