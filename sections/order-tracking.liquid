<div class="py-8 sm:py-14 bg-brand-cream" data-section-id="{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    {% render 'breadcrumbs' %}

    <div class="py-6 sm:py-8 space-y-10 max-w-3xl mx-auto">
      <!-- Header -->
      <div class="text-center space-y-3">
        <span class="text-[10px] sm:text-xs uppercase tracking-ultra text-brand-gold font-semibold">
          ATELIER DISPATCH LEDGER
        </span>
        <h1 class="text-3xl sm:text-4xl font-light text-brand-espresso uppercase tracking-tight">
          Track Your Consignment
        </h1>
        <p class="text-xs sm:text-sm text-brand-mutedGray font-light leading-relaxed">
          Monitor the progression of your handcrafted heirloom from master karigar formulation to white-glove arrival.
        </p>
      </div>

      <!-- Tracking Lookup Card -->
      <div class="bg-[#FCFBF9] border border-[#EDE4D8] rounded-sm p-6 sm:p-8 shadow-sm space-y-6">
        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="space-y-1">
              <label class="block font-semibold uppercase tracking-wider text-brand-espresso" for="tracking-ref">Order Reference No. *</label>
              <input type="text" id="tracking-ref" placeholder="e.g. CC-2026-00001" value="CC-2026-00001" class="w-full p-3 bg-brand-cream border border-[#EDE4D8] rounded-sm uppercase tracking-wider text-xs focus:border-brand-burgundy focus:outline-none">
            </div>
            <div class="space-y-1">
              <label class="block font-semibold uppercase tracking-wider text-brand-espresso" for="tracking-contact">Email or Phone Number *</label>
              <input type="text" id="tracking-contact" placeholder="Registered contact" value="patron@royal.in" class="w-full p-3 bg-brand-cream border border-[#EDE4D8] rounded-sm text-xs focus:border-brand-burgundy focus:outline-none">
            </div>
          </div>

          <button
            type="button"
            onclick="trackConsignment()"
            class="w-full py-3.5 bg-brand-burgundy text-[#FAF7F2] text-xs uppercase tracking-widest font-semibold rounded-sm hover:bg-brand-deepWine transition-colors shadow-sm cursor-pointer"
          >
            LOCATE CONSIGNMENT STATUS
          </button>
        </div>

        <!-- Live Status Timeline (Mock result based on lookup) -->
        <div id="tracking-timeline" class="border-t border-[#EDE4D8] pt-6 space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase tracking-widest text-brand-gold font-semibold">Active Consignment</span>
              <h3 class="text-sm font-semibold text-brand-espresso uppercase">Dossier: <span id="display-ref">#CC-2026-00001</span></h3>
            </div>
            <span class="text-[11px] font-semibold text-brand-burgundy bg-brand-champagne px-3 py-1 rounded border border-brand-gold/30 uppercase">
              In Formulation (Stage 2 of 4)
            </span>
          </div>

          <!-- Stepper Visual -->
          <div class="relative pl-6 border-l-2 border-brand-burgundy space-y-8 text-xs">
            <!-- Step 1 -->
            <div class="relative">
              <span class="absolute -left-[31px] top-0 w-4 h-4 rounded-full bg-brand-burgundy text-white flex items-center justify-center text-[9px]">✓</span>
              <h4 class="font-semibold text-brand-espresso uppercase">Atelier Sanction Confirmed</h4>
              <p class="text-brand-mutedGray text-[11px] mt-0.5">Order verified &amp; bespoke measurements docket issued to senior master draper.</p>
              <span class="text-[10px] text-brand-gold uppercase">Completed • Sep 24, 2026</span>
            </div>

            <!-- Step 2 -->
            <div class="relative">
              <span class="absolute -left-[31px] top-0 w-4 h-4 rounded-full bg-brand-gold text-white flex items-center justify-center text-[9px] animate-pulse">●</span>
              <h4 class="font-semibold text-brand-burgundy uppercase">Karigar Hand-Needlecraft (Active)</h4>
              <p class="text-brand-mutedGray text-[11px] mt-0.5">Zardozi zari embroidery &amp; micro-pleating underway in the Mehrauli Atelier.</p>
              <span class="text-[10px] text-brand-burgundy font-semibold uppercase">Currently in Progress • Estimated Completion: Oct 02</span>
            </div>

            <!-- Step 3 -->
            <div class="relative opacity-60">
              <span class="absolute -left-[31px] top-0 w-4 h-4 rounded-full bg-[#EDE4D8] text-[#706465] flex items-center justify-center text-[9px]">○</span>
              <h4 class="font-semibold text-brand-espresso uppercase">Quality &amp; Drape Inspection</h4>
              <p class="text-brand-mutedGray text-[11px] mt-0.5">Lead artisan fitting review &amp; archival cedar casing sanction.</p>
              <span class="text-[10px] text-brand-mutedGray uppercase">Pending</span>
            </div>

            <!-- Step 4 -->
            <div class="relative opacity-60">
              <span class="absolute -left-[31px] top-0 w-4 h-4 rounded-full bg-[#EDE4D8] text-[#706465] flex items-center justify-center text-[9px]">○</span>
              <h4 class="font-semibold text-brand-espresso uppercase">White Glove Delivery</h4>
              <p class="text-brand-mutedGray text-[11px] mt-0.5">Dispatched via private diplomatic courier with signature reception.</p>
              <span class="text-[10px] text-brand-mutedGray uppercase">Pending</span>
            </div>
          </div>

          <div class="p-4 bg-brand-champagne/40 border border-[#EDE4D8] rounded-sm text-xs flex flex-col sm:flex-row items-center justify-between gap-3">
            <span class="text-brand-mutedGray">Need immediate assistance or rush rescheduling?</span>
            <a href="/pages/contact" class="text-brand-burgundy font-semibold uppercase tracking-wider underline">Contact Dedicated Liaison →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function trackConsignment() {
    const ref = document.getElementById('tracking-ref').value.trim();
    if (ref) {
      document.getElementById('display-ref').innerText = '#' + ref.replace('#', '');
      showToast('Consignment docket synchronized.');
    }
  }
</script>

{% schema %}
{
  "name": "Order Tracking Page",
  "settings": []
}
{% endschema %}
