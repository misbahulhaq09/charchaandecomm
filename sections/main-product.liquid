<div class="py-8 sm:py-12 bg-brand-cream" data-section-id="{{ section.id }}" data-section-type="product">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    {% render 'breadcrumbs' %}

    <!-- Split Product Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mt-6">
      
      <!-- LEFT: PRODUCT MEDIA GALLERY (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col-reverse md:flex-row gap-4 lg:gap-6">
        <!-- Thumbnails -->
        {%- if product.media.size > 1 -%}
          <div class="flex md:flex-col gap-3 overflow-x-auto md:overflow-visible shrink-0 pb-2 md:pb-0" id="product-thumbnails">
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumb-btn relative w-20 h-28 lg:w-24 lg:h-32 bg-[#EDE5DA] rounded-sm overflow-hidden p-1 transition-all duration-300 shadow-sm {% if forloop.first %}ring-1 ring-brand-gold{% else %}opacity-70 hover:opacity-100{% endif %}"
                onclick="document.getElementById('main-product-img').src = '{{ media | image_url: width: 1200 }}'; document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('ring-1', 'ring-brand-gold', 'opacity-100')); this.classList.add('ring-1', 'ring-brand-gold', 'opacity-100');"
              >
                <img
                  src="{{ media | image_url: width: 200 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  class="w-full h-full object-cover"
                >
                <span class="absolute bottom-1 right-1 text-[9px] uppercase bg-[#FAF7F2]/90 text-brand-burgundy px-1 font-semibold">0{{ forloop.index }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Main Image Canvas -->
        <div class="flex-1 relative bg-[#F5ECE1] rounded-sm overflow-hidden shadow-sm group">
          <div class="relative w-full aspect-[3/4] flex items-center justify-center overflow-hidden">
            {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
            <img
              id="main-product-img"
              src="{{ featured_media | image_url: width: 1200 }}"
              alt="{{ featured_media.alt | default: product.title | escape }}"
              class="w-full h-full object-cover object-top transition-transform duration-700 select-none group-hover:scale-105"
            >

            <!-- Badges -->
            <div class="absolute top-4 left-4 flex flex-col gap-2 pointer-events-none">
              <span class="bg-brand-burgundy text-[#FAF7F2] text-[9px] uppercase tracking-widest px-3 py-1 font-semibold shadow-sm">COUTURE ARCHIVE</span>
              <span class="bg-[#FAF7F2]/90 backdrop-blur-sm text-brand-gold text-[9px] uppercase tracking-wider px-2.5 py-0.5 font-semibold shadow-sm">450+ KARIGAR HOURS</span>
            </div>

            <!-- Floating Wishlist Heart -->
            <button
              type="button"
              data-wishlist-btn
              data-wishlist-handle="{{ product.handle }}"
              data-wishlist-title="{{ product.title | escape }}"
              data-wishlist-price="{{ product.price | money }}"
              data-wishlist-image="{{ featured_media | image_url: width: 300 }}"
              data-wishlist-url="{{ product.url }}"
              aria-label="Save to Wishlist"
              class="absolute top-4 right-4 w-10 h-10 rounded-full bg-[#FAF7F2]/90 backdrop-blur-sm flex items-center justify-center text-brand-burgundy shadow-sm hover:scale-110 active:scale-95 transition-all cursor-pointer z-10"
            >
              {% render 'icon', name: 'heart', class: 'w-4 h-4' %}
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT: PRODUCT PURCHASING & DETAILS (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col space-y-6 lg:sticky lg:top-28">
        <!-- Category & Availability Header -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-[11px] uppercase tracking-widest">
            <span class="text-brand-gold font-semibold">
              {{ product.type | default: 'HAUTE COUTURE' }}
            </span>
            {%- if product.available -%}
              <span class="text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full font-medium">
                In Stock for Trial
              </span>
            {%- else -%}
              <span class="text-[#BA1A1A] bg-red-50 border border-red-200 px-2.5 py-0.5 rounded-full font-medium">
                Archived Piece
              </span>
            {%- endif -%}
          </div>

          <h1 class="text-2xl sm:text-3xl font-light text-brand-espresso uppercase tracking-tight">
            {{ product.title }}
          </h1>

          <!-- Price Display -->
          <div class="flex items-baseline gap-3 pt-1">
            <span class="text-xl sm:text-2xl font-semibold text-brand-burgundy tracking-wide" id="ProductPrice">
              {{ product.selected_or_first_available_variant.price | money }}
            </span>
            {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
              <span class="text-sm text-brand-mutedGray/60 line-through tracking-wide" id="ComparePrice">
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </span>
            {%- endif -%}
          </div>
        </div>

        <!-- Shopify Product Form -->
        {% form 'product', product, id: 'AddToCartForm', class: 'space-y-6' %}
          <!-- Variant Selectors -->
          {%- unless product.has_only_default_variant -%}
            <div class="space-y-4">
              {%- for option in product.options_with_values -%}
                <div class="space-y-2">
                  <div class="flex justify-between items-center text-xs uppercase tracking-widest">
                    <label for="Option-{{ forloop.index0 }}" class="text-brand-espresso font-semibold">
                      {{ option.name }}: <span class="text-brand-gold" id="OptionVal-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                    </label>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {%- for value in option.values -%}
                      <label class="cursor-pointer">
                        <input
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                          class="sr-only peer"
                          onchange="document.getElementById('OptionVal-{{ forloop.parentloop.index0 }}').innerText = this.value; updateVariantSelection();"
                        >
                        <span class="inline-block px-4 py-2 border border-[#EDE4D8] peer-checked:border-brand-burgundy peer-checked:bg-brand-burgundy peer-checked:text-[#FAF7F2] text-xs uppercase tracking-wider rounded-sm transition-all hover:border-brand-gold">
                          {{ value }}
                        </span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Hidden Variant ID -->
          <input
            type="hidden"
            name="id"
            id="ProductSelect"
            value="{{ product.selected_or_first_available_variant.id }}"
          >

          <!-- Quantity Selector -->
          <div class="space-y-2">
            <label class="block text-xs uppercase tracking-widest text-brand-espresso font-semibold">Quantity</label>
            <div class="flex items-center w-32 border border-[#EDE4D8] rounded-sm bg-[#FAF7F2]">
              <button type="button" class="w-10 h-10 flex items-center justify-center text-brand-espresso hover:bg-[#F5ECE1]" onclick="const q = document.getElementById('Quantity'); if(q.value > 1) q.value--;">-</button>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" class="w-12 text-center text-xs font-semibold bg-transparent focus:outline-none border-none">
              <button type="button" class="w-10 h-10 flex items-center justify-center text-brand-espresso hover:bg-[#F5ECE1]" onclick="const q = document.getElementById('Quantity'); q.value++;">+</button>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-3 pt-2">
            <button
              type="submit"
              name="add"
              class="w-full py-4 bg-brand-burgundy text-brand-cream border border-brand-gold/40 text-xs uppercase tracking-widest font-semibold rounded-sm hover:bg-brand-deepWine transition-all shadow-sm cursor-pointer"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}
                ADD TO CONSIGNMENT BAG
              {%- else -%}
                ARCHIVED / SOLD OUT
              {%- endif -%}
            </button>

            {%- if product.available -%}
              <div class="shopify-payment-button-wrapper">
                {{ form | payment_button }}
              </div>
            {%- endif -%}
          </div>
        {% endform %}

        <!-- Bespoke Consultation Banner -->
        <div class="p-4 bg-brand-champagne/70 border border-[#EDE4D8] rounded-sm flex items-start gap-3 text-xs">
          <span class="text-brand-gold text-lg">⚜</span>
          <div class="space-y-1">
            <h4 class="font-semibold text-brand-burgundy uppercase tracking-wider">Atelier Fitting Service</h4>
            <p class="text-brand-mutedGray text-[11px] leading-relaxed">
              Every creation is custom-tailored to your measurements. Schedule a complimentary bespoke fitting with our master stylists.
            </p>
            <a href="/pages/contact" class="inline-block pt-1 text-brand-burgundy font-semibold uppercase tracking-widest text-[10px] underline">
              Book Concierge Consultation →
            </a>
          </div>
        </div>

        <!-- Accordions / Description Tabs -->
        <div class="border-t border-[#EDE4D8] divide-y divide-[#EDE4D8] text-xs">
          <details class="py-3 group" open>
            <summary class="flex justify-between items-center cursor-pointer uppercase tracking-widest font-semibold text-brand-espresso">
              <span>Heirloom Description</span>
              <span class="transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="pt-3 text-brand-mutedGray font-light leading-relaxed prose prose-sm">
              {{ product.description | default: 'Handcrafted in pure mulberry silk with intricate Zardozi and Dabka needlework. Custom fitted by Char Chaand master artisans.' }}
            </div>
          </details>

          <details class="py-3 group">
            <summary class="flex justify-between items-center cursor-pointer uppercase tracking-widest font-semibold text-brand-espresso">
              <span>Karigar Hours & Needlecraft</span>
              <span class="transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="pt-3 text-brand-mutedGray font-light leading-relaxed">
              Crafted across 450+ dedicated karigar hours utilizing antique copper-core zari thread, micro-cut mirrors, and hand-beaded borders.
            </div>
          </details>

          <details class="py-3 group">
            <summary class="flex justify-between items-center cursor-pointer uppercase tracking-widest font-semibold text-brand-espresso">
              <span>White Glove Delivery & Packaging</span>
              <span class="transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="pt-3 text-brand-mutedGray font-light leading-relaxed">
              Delivered in an archival velvet-lined wooden keepsake box with cedar garment preservation casing and authenticity certificate.
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Variant switcher logic for Shopify products
  const productVariants = {{ product.variants | json }};
  function updateVariantSelection() {
    const selectedOptions = [];
    document.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
      selectedOptions.push(radio.value);
    });

    const matchedVariant = productVariants.find(v => {
      return v.options.every((opt, idx) => opt === selectedOptions[idx]);
    });

    if (matchedVariant) {
      document.getElementById('ProductSelect').value = matchedVariant.id;
      const formattedPrice = (matchedVariant.price / 100).toLocaleString('en-IN', {
        style: 'currency',
        currency: '{{ cart.currency.iso_code }}' || 'INR',
        maximumFractionDigits: 0
      });
      document.getElementById('ProductPrice').innerText = formattedPrice;

      if (matchedVariant.featured_media && matchedVariant.featured_media.preview_image) {
        document.getElementById('main-product-img').src = matchedVariant.featured_media.preview_image.src;
      }
    }
  }
</script>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
