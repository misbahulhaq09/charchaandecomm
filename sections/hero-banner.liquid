<section class="relative bg-brand-warmIvory overflow-visible border-b border-[#E8DFD3] z-[55]" data-purpose="hero-banner">
  <!-- Architectural Arch Background Layer (Full bleed) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    {%- if section.settings.bg_image != blank -%}
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" class="w-full h-full object-cover object-left">
    {%- else -%}
      <img src="{{ 'hero_bg.png' | asset_url }}" alt="Architectural Arch Background" class="w-full h-full object-cover object-left">
    {%- endif -%}
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-[460px] lg:min-h-[520px]">
      <!-- Left Editorial Content (Hero content / text layer) -->
      <div class="lg:col-span-5 flex flex-col justify-center text-left space-y-4 sm:space-y-6 z-10 max-w-[60%] sm:max-w-none hero-editorial-content">
        <span class="text-xs uppercase tracking-ultra font-semibold text-brand-gold">
          {{ section.settings.subheading | default: 'AUTUMN / WINTER COUTURE' }}
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl xl:text-7xl font-light text-brand-espresso leading-[1.08] tracking-tight uppercase">
          {{ section.settings.heading | default: 'CHAR CHAAND' }}
        </h1>
        <p class="text-xl sm:text-2xl lg:text-3xl italic text-brand-mutedGray font-normal -mt-1 sm:-mt-2">
          {{ section.settings.tagline | default: 'Crafted with Elegance.' }}
        </p>
        <p class="text-xs sm:text-sm text-brand-mutedGray tracking-wider font-light max-w-md leading-relaxed">
          {{ section.settings.description | default: 'Elevated heirloom couture and sculpted silhouettes, meticulously woven for celebrations of timeless grace.' }}
        </p>
        <div class="pt-3 sm:pt-4 flex flex-wrap items-center gap-3 sm:gap-5">
          <a class="px-6 sm:px-8 py-3 sm:py-3.5 bg-brand-burgundy text-brand-cream border border-brand-gold/50 text-xs tracking-widest uppercase font-medium rounded-sm hover:bg-brand-deepWine transition-all shadow-sm" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_text | default: 'SHOP NOW' }}
          </a>
          <a class="text-xs uppercase tracking-widest font-semibold text-brand-espresso hover:text-brand-burgundy flex items-center gap-2 group transition-colors py-1.5" href="{{ section.settings.secondary_link | default: '#new-arrivals' }}">
            {{ section.settings.secondary_text | default: 'EXPLORE ATELIER' }} <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
      <!-- Right Visual Spacer keeping grid balance -->
      <div class="lg:col-span-7 hidden lg:block pointer-events-none min-h-[460px]"></div>
    </div>
  </div>

  <!-- Female Model Cutout Foreground Layer (Independent DOM Layer) -->
  <div class="char-chaand-hero-model pointer-events-none" aria-hidden="true">
    {%- if section.settings.model_image != blank -%}
      <img 
        src="{{ section.settings.model_image | image_url: width: 1200 }}" 
        alt="Char Chaand Haute Couture Model" 
        class="char-chaand-hero-model-img"
      />
    {%- else -%}
      <img 
        src="{{ 'char_chaand_model.png' | asset_url }}" 
        alt="Char Chaand Haute Couture Model" 
        class="char-chaand-hero-model-img"
      />
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Master Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "AUTUMN / WINTER COUTURE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHAR CHAAND"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Crafted with Elegance."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elevated heirloom couture and sculpted silhouettes, meticulously woven for celebrations of timeless grace."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Link Text",
      "default": "EXPLORE ATELIER"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Optional override)"
    },
    {
      "type": "image_picker",
      "id": "model_image",
      "label": "Model Cutout Image (Optional override)"
    }
  ],
  "presets": [
    {
      "name": "Master Hero Banner"
    }
  ]
}
{% endschema %}
