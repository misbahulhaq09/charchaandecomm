<section class="py-12 sm:py-14 bg-brand-cream border-b border-[#EDE4D8]" data-purpose="circular-category-navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-7 gap-6 sm:gap-8 justify-items-center">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign col_obj = block.settings.collection -%}
          {%- assign col_url = block.settings.url | default: col_obj.url | default: routes.all_products_collection_url -%}
          {%- assign col_title = block.settings.title | default: col_obj.title | default: 'Category' -%}
          {%- assign col_img = block.settings.image | default: col_obj.featured_image -%}

          <a class="group flex flex-col items-center text-center space-y-3" href="{{ col_url }}" {{ block.shopify_attributes }}>
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border border-brand-gold/50 p-1 group-hover:border-brand-burgundy transition-colors bg-[#F5ECE1] circle-glow">
              <div class="w-full h-full rounded-full overflow-hidden relative">
                {%- if col_img != blank -%}
                  <img src="{{ col_img | image_url: width: 250 }}" alt="{{ col_title | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                {%- else -%}
                  <div class="w-full h-full flex items-center justify-center bg-[#EDE4D8] text-[9px] uppercase font-semibold text-[#706465]">
                    {{ col_title }}
                  </div>
                {%- endif -%}
              </div>
            </div>
            <span class="text-[11px] font-medium uppercase tracking-widest text-brand-espresso group-hover:text-brand-burgundy transition-colors">
              {{ col_title }}
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Pre-configured Default Categories -->
        <a class="group flex flex-col items-center text-center space-y-3" href="{{ routes.all_products_collection_url }}">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border border-brand-gold/50 p-1 group-hover:border-brand-burgundy transition-colors bg-[#F5ECE1] circle-glow">
            <div class="w-full h-full rounded-full overflow-hidden relative">
              <img alt="Indo Western" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuABe1FtAyPtyIPLFjiMxXn4bYIaBnOIKiXWmEHSLfiRapTd8gqozoHumkQXWJiDQk86Onlrd3QhuYaYZ7SRqrrvwp9BqfpRIEHAM8oh92-DacTr4uDb7jlP3_F4JhG0QSMhI6bUTiP4l-MysXNpxcDzPZZV_7rtyUsaKzvZYzriC7Y_CxOYJWd3x0mYvwwq5_y3g20T_DKeDfYsR7003Gy49sAjWZPko2omyjD8anhQAQf51KwcGdyc">
