{% schema %}
{
  "name": "Circular Categories",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom URL (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Thumbnail Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Circular Categories"
    }
  ]
}
{% endschema %}
