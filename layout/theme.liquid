<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Google Fonts: Montserrat (Clean Sans-Serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>

  <!-- Tailwind CSS Engine -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              cream: '#FAF7F2',
              warmIvory: '#F5EFEB',
              champagne: '#F3ECE4',
              gold: '#C5A880',
              deepGold: '#A58253',
              burgundy: '#4A0E17',
              deepWine: '#3B0A11',
              espresso: '#1F1617',
              mutedGray: '#706465',
              cardIvory: '#FCFBF9'
            }
          },
          fontFamily: {
            sans: ['"Montserrat"', 'system-ui', 'sans-serif'],
          },
          letterSpacing: {
            widest: '0.22em',
            ultra: '0.28em'
          }
        }
      }
    }
  </script>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>

<body class="bg-brand-cream text-brand-espresso antialiased selection:bg-brand-burgundy selection:text-brand-cream min-h-screen flex flex-col font-sans">
  <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-brand-burgundy focus:text-brand-cream" href="#MainContent">
    Skip to content
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="flex-grow focus:outline-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
